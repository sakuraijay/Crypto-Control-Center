modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "vm"
build = ["pnpm", "run", "build:deploy"]
run = ["pnpm", "run", "start:deploy"]

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck-all"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test-all"

[[workflows.workflow]]
name = "typecheck-all"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/typecheck-ci.sh"

[[workflows.workflow]]
name = "test-all"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run test 2>&1"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
LIVE_TEST_EXECUTION_LOCKED = "true"
DELEGATED_SIGNER_ENABLED = "false"
GMX_WALLET_ADDRESS = "0x46c27887c5EC5E36b2a21E1Ec1BC69e7a593950e"
