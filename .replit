modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "vm"
build = ["pnpm", "run", "build:deploy"]
run = ["pnpm", "run", "start:deploy"]

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck-all"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test-all"

[[workflows.workflow]]
name = "typecheck-all"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/typecheck-ci.sh"

[[workflows.workflow]]
name = "test-all"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run test 2>&1"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
LIVE_TEST_EXECUTION_LOCKED = "true"
GMX_WALLET_ADDRESS = "0x46c27887c5EC5E36b2a21E1Ec1BC69e7a593950e"
GMX_CHAIN_ID = "42161"
GMX_SUBACCOUNT_GELATO_RELAY_ROUTER_ADDRESS = "0xfD0596f708d9D950E0eF7b5d191e5F8e55b8a67f"
GMX_DATA_STORE_ADDRESS = "0xFD70de6b91282D8017aA4E741e9Ae325CAb992d8"
GMX_EVENT_EMITTER_ADDRESS = "0xC8ee91A54287DB53897056e12D9819156D3822Fb"
GMX_ORDER_VAULT_ADDRESS = "0x31eF83a530Fde1B38EE9A18093A333D8Bbbc40D5"
GMX_RELAY_READONLY_NETWORK_ENABLED = "true"

[userenv.production]
GMX_API_READONLY_ENABLED = "true"
DELEGATED_SIGNER_ENABLED = "true"

[userenv.development]
DELEGATED_SIGNER_ENABLED = "false"
