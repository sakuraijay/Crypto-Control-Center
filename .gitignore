.env
.env.*
.env.local
.env.development
.env.production
.env.staging
*.env
secrets.json
secrets.*.json
*.pem
*.key
*.p12
*.pfx
*.cert

# ── Agent instruction uploads — never commit to GitHub ────────────────────────
attached_assets/

